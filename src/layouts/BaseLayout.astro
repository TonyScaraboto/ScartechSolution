---
// Learn about using Astro layouts:
// https://docs.astro.build/en/core-concepts/layouts/

import { ClientRouter } from 'astro:transitions';
import Footer from '../components/Footer.astro';
// Component Imports
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
}

const { title, description } = Astro.props;
---

<html lang="pt-BR">
	<head>
		<MainHead title={title} description={description} />
		<ClientRouter />
	</head>
	<body>
		<div class="stack backgrounds">
			<Nav />
			<slot />
			<Footer />
		</div>
		<a href="https://wa.me/5513991836523?text=Olá,%20gostaria%20de%20saber%20mais%20sobre%20sites%20e%20tráfego%20pago!" class="whatsapp-float" target="_blank" rel="noopener noreferrer" aria-label="Fale conosco no WhatsApp">
			<svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
				<circle cx="28" cy="28" r="28" fill="#25D366"/>
				<path d="M38.7 26.3c0-5.9-4.8-10.7-10.7-10.7-5.9 0-10.7 4.8-10.7 10.7 0 1.8.5 3.5 1.3 5l-1.4 5.1 5.2-1.4c1.5.8 3.1 1.3 4.9 1.3h.6c5.9 0 10.7-4.8 10.7-10.7v-.3zm-10.7 9.3c-1.6 0-3.1-.4-4.5-1.2l-.3-.2-3.3.9.9-3.2-.2-.3c-.8-1.4-1.2-2.9-1.2-4.5 0-4.9 4-8.9 8.9-8.9s8.9 4 8.9 8.9-4 8.9-8.9 8.9v.6zm4.9-6.7c-.3-.1-1.6-.8-1.8-.9-.3-.1-.5-.1-.7.1-.2.3-.7.9-.9 1.1-.2.2-.4.2-.7.1-.3-.1-1.4-.5-2.6-1.6-.9-.8-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.6.1-.1.3-.4.5-.5.1-.2.2-.3.3-.5s.1-.4 0-.5c-.1-.1-.7-1.6-1-2.2-.3-.6-.6-.5-.8-.5h-.7c-.2 0-.6.1-.9.4-.3.3-.9.9-.9 2.2s1 2.5 1.1 2.7c.1.2 2 3.1 4.8 4.3.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.6-.1 1.6-.7 1.9-1.3.3-.7.3-1.2.2-1.3-.1-.1-.3-.2-.6-.3z" fill="white"/>
			</svg>
		</a>
		<script>
			// Add “loaded” class once the document has completely loaded.
			addEventListener('load', () => document.documentElement.classList.add('loaded'));
		</script>
		<style>
			.whatsapp-float {
				position: fixed;
				right: 2.2rem;
				bottom: 2.2rem;
				z-index: 1000;
				box-shadow: 0 4px 16px 0 rgba(37,211,102,0.18);
				border-radius: 50%;
				transition: transform 0.18s;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			@media (hover: hover) {
				.whatsapp-float:hover {
					transform: scale(1.08);
					box-shadow: 0 8px 32px 0 rgba(37,211,102,0.28);
				}
			}
		</style>
		<style>
			.backgrounds {
				min-height: 100%;
				isolation: isolate;
				background: #f8fafc;
			}
		</style>
	</body>
</html>
