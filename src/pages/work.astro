---
import ContactCTA from '../components/ContactCTA.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Portfólio | Scartech Solution"
	description="Projetos de sites, e-commerce e campanhas de tráfego pago"
>
	<div class="portfolio-container">
		<!-- Hero -->
		<section class="hero-portfolio">
			<h1 class="hero-title">Nosso <span class="highlight">Portfólio</span></h1>
			<p class="hero-subtitle">Projetos reais de sites, e-commerce e campanhas de tráfego pago</p>
		</section>

		<!-- Estatísticas de Impacto -->
		<section class="impact-stats">
			<div class="stat-card">
				<img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=800&q=80" alt="Sites entregues" class="stat-img" />
				<div class="stat-number">50+</div>
				<div class="stat-label">Sites e lojas entregues</div>
			</div>
			<div class="stat-card">
				<img src="https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?auto=format&fit=crop&w=800&q=80" alt="Campanhas" class="stat-img" />
				<div class="stat-number">100+</div>
				<div class="stat-label">Campanhas de tráfego gerenciadas</div>
			</div>
			<div class="stat-card">
				<img src="https://images.unsplash.com/photo-1556761175-5973dc0f32e7?auto=format&fit=crop&w=800&q=80" alt="Satisfação" class="stat-img" />
				<div class="stat-number">100%</div>
				<div class="stat-label">Satisfação dos clientes</div>
			</div>
			<div class="stat-card">
				<img src="https://images.unsplash.com/photo-1551434678-e076c223a692?auto=format&fit=crop&w=800&q=80" alt="Suporte" class="stat-img" />
				<div class="stat-number">3x</div>
				<div class="stat-label">ROI médio em campanhas</div>
			</div>
		</section>

		<!-- Projetos -->
		<section class="projects-section">
			<h2 class="section-title">Projetos Entregues</h2>
			<p class="section-subtitle">Projetos reais desenvolvidos pela Scartech Solution, com sites publicados e código no GitHub</p>

			<div class="filter-bar">
				<button class="filter-btn active" data-filter="todos">Todos</button>
				<button class="filter-btn" data-filter="sites">Sites Institucionais</button>
				<button class="filter-btn" data-filter="ecommerce">Loja Virtual</button>
				<button class="filter-btn" data-filter="landing">Landing Pages</button>
				<button class="filter-btn" data-filter="sistemas">Sistemas Web</button>
			</div>

			<div class="projects-grid">
				<div class="project-card" data-category="sites">
					<div class="mockup-scene">
						<div class="mockup-desktop">
							<div class="mockup-browser-bar"><span></span><span></span><span></span></div>
							<img src="/assets/portfolio/gm-eletrica-desktop.png" alt="Site GM Elétrica em desktop" loading="lazy" />
						</div>
						<div class="mockup-phone">
							<img src="/assets/portfolio/gm-eletrica-mobile.png" alt="Site GM Elétrica em celular" loading="lazy" />
						</div>
					</div>
					<div class="project-info">
						<span class="project-tag">Site Institucional</span>
						<h3>GM Elétrica</h3>
						<p>Site institucional para empresa de serviços elétricos residenciais, empresariais e industriais, com catálogo de serviços e contato via WhatsApp</p>
					</div>
				</div>
				<div class="project-card" data-category="sites">
					<div class="mockup-scene">
						<div class="mockup-desktop">
							<div class="mockup-browser-bar"><span></span><span></span><span></span></div>
							<img src="/assets/portfolio/lele-estudio-desktop.png" alt="Site Lelê Estúdio Automotivo em desktop" loading="lazy" />
						</div>
						<div class="mockup-phone">
							<img src="/assets/portfolio/lele-estudio-mobile.png" alt="Site Lelê Estúdio Automotivo em celular" loading="lazy" />
						</div>
					</div>
					<div class="project-info">
						<span class="project-tag">Site Institucional</span>
						<h3>Lelê Estúdio Automotivo</h3>
						<p>Site institucional para estúdio de estética automotiva, com serviços e valores de lavagem e detalhamento de carros e motos</p>
					</div>
				</div>
				<div class="project-card" data-category="ecommerce">
					<div class="mockup-scene">
						<div class="mockup-desktop">
							<div class="mockup-browser-bar"><span></span><span></span><span></span></div>
							<img src="/assets/portfolio/rws-eventos-desktop.png" alt="Loja virtual RWS Eventos em desktop" loading="lazy" />
						</div>
						<div class="mockup-phone">
							<img src="/assets/portfolio/rws-eventos-mobile.png" alt="Loja virtual RWS Eventos em celular" loading="lazy" />
						</div>
					</div>
					<div class="project-info">
						<span class="project-tag tag-ecommerce">Loja Virtual</span>
						<h3>RWS Eventos</h3>
						<p>Loja virtual de locação para festas e eventos, com catálogo de brinquedos e decorações, montagem de pedido online e orçamento pelo WhatsApp</p>
					</div>
				</div>
				<div class="project-card" data-category="landing">
					<div class="mockup-scene">
						<div class="mockup-desktop">
							<div class="mockup-browser-bar"><span></span><span></span><span></span></div>
							<img src="/assets/portfolio/maxpower-desktop.png" alt="Site MaxPower em desktop" loading="lazy" />
						</div>
						<div class="mockup-phone">
							<img src="/assets/portfolio/maxpower-mobile.png" alt="Site MaxPower em celular" loading="lazy" />
						</div>
					</div>
					<div class="project-info">
						<span class="project-tag tag-landing">Landing Page Internacional</span>
						<h3>MaxPower</h3>
						<p>Landing page em inglês para indústria de aquecedores e isolamento térmico, com catálogo de produtos e captação de leads no mercado americano</p>
					</div>
				</div>
				<div class="project-card" data-category="sistemas">
					<div class="mockup-scene">
						<div class="mockup-desktop">
							<div class="mockup-browser-bar"><span></span><span></span><span></span></div>
							<img src="/assets/portfolio/scartech-manager-desktop.png" alt="Sistema ScarTech Manager em desktop" loading="lazy" />
						</div>
						<div class="mockup-phone">
							<img src="/assets/portfolio/scartech-manager-mobile.png" alt="Sistema ScarTech Manager em celular" loading="lazy" />
						</div>
					</div>
					<div class="project-info">
						<span class="project-tag tag-sistema">Sistema Web</span>
						<h3>ScarTech Manager</h3>
						<p>Sistema completo de gestão para assistências técnicas, com painel administrativo, controle de ordens de serviço e área de login para clientes</p>
					</div>
				</div>
			</div>
		</section>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
.portfolio-container {
	background: #f8fafc;
	min-height: 100vh;
	position: relative;
	z-index: 2;
	padding-top: 7rem;
	overflow: hidden;
}

.hero-portfolio {
	max-width: 1400px;
	margin: 0 auto 4rem;
	padding: 0 2rem;
	text-align: center;
}

.hero-title {
	font-size: 4rem;
	font-weight: 900;
	color: #0f172a;
	margin-bottom: 1.5rem;
}

.highlight {
	background: linear-gradient(135deg, #3b82f6, #2563eb);
	-webkit-background-clip: text;
	-webkit-text-fill-color: transparent;
	background-clip: text;
}

.hero-subtitle {
	font-size: 1.4rem;
	color: #64748b;
}

.section-title {
	font-size: 2.5rem;
	font-weight: 900;
	color: #0f172a;
	margin-bottom: 3rem;
	text-align: center;
}

/* Stats */
.impact-stats {
	max-width: 1400px;
	margin: 0 auto 4rem;
	padding: 0 2rem;
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	gap: 2rem;
}

.stat-card {
	background: #ffffff;
	padding: 2rem;
	border-radius: 1rem;
	border: 1px solid #e2e8f0;
	box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
	text-align: center;
	transition: transform 0.3s ease, box-shadow 0.3s ease;
	overflow: hidden;
	position: relative;
}

.stat-card:hover {
	transform: translateY(-6px);
	box-shadow: 0 16px 40px rgba(37, 99, 235, 0.12);
}

.stat-img {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	object-fit: cover;
	opacity: 0.1;
	z-index: -1;
}

.stat-number {
	font-size: 3.5rem;
	font-weight: 900;
	background: linear-gradient(135deg, #3b82f6, #2563eb);
	-webkit-background-clip: text;
	-webkit-text-fill-color: transparent;
	background-clip: text;
	margin-bottom: 0.5rem;
}

.stat-label {
	color: #64748b;
	font-size: 1rem;
}

/* Projects */
.projects-section {
	max-width: 1400px;
	margin: 4rem auto;
	padding: 0 2rem;
}

.section-subtitle {
	color: #64748b;
	font-size: 1.15rem;
	text-align: center;
	max-width: 600px;
	margin: -2rem auto 2.5rem;
}

/* Filtro */
.filter-bar {
	display: flex;
	justify-content: center;
	gap: 0.75rem;
	flex-wrap: wrap;
	margin-bottom: 3rem;
}

.filter-btn {
	background: #ffffff;
	border: 1px solid #cbd5e1;
	color: #475569;
	font-weight: 600;
	font-size: 0.9rem;
	padding: 0.6rem 1.4rem;
	border-radius: 2rem;
	cursor: pointer;
	transition: all 0.25s ease;
	font-family: inherit;
}

.filter-btn:hover {
	border-color: #93c5fd;
	color: #1e40af;
}

.filter-btn.active {
	background: #1e40af;
	border-color: #1e40af;
	color: #ffffff;
}

/* Grid de projetos */
.projects-grid {
	display: grid;
	grid-template-columns: repeat(2, 1fr);
	gap: 2rem;
	max-width: 1100px;
	margin: 0 auto;
}

.project-card {
	background: #ffffff;
	border-radius: 1rem;
	overflow: hidden;
	border: 1px solid #e2e8f0;
	box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
	transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.project-card:hover {
	transform: translateY(-6px);
	box-shadow: 0 16px 40px rgba(37, 99, 235, 0.12);
}

.project-card.hidden {
	display: none;
}

/* Cena do mockup (desktop + celular) */
.mockup-scene {
	position: relative;
	background: linear-gradient(145deg, #eef2f7 0%, #e2e8f0 100%);
	padding: 2.5rem 1.5rem 0 5.5rem;
	height: 300px;
	overflow: hidden;
}

.mockup-desktop {
	background: #ffffff;
	border-radius: 0.6rem 0.6rem 0 0;
	box-shadow: 0 18px 40px rgba(15, 23, 42, 0.22);
	overflow: hidden;
	height: 100%;
	transition: transform 0.4s ease;
}

.mockup-browser-bar {
	display: flex;
	align-items: center;
	gap: 0.35rem;
	background: #f1f5f9;
	border-bottom: 1px solid #e2e8f0;
	padding: 0.45rem 0.7rem;
}

.mockup-browser-bar span {
	width: 9px;
	height: 9px;
	border-radius: 50%;
	background: #cbd5e1;
}

.mockup-browser-bar span:nth-child(1) { background: #fca5a5; }
.mockup-browser-bar span:nth-child(2) { background: #fcd34d; }
.mockup-browser-bar span:nth-child(3) { background: #86efac; }

.mockup-desktop img {
	width: 100%;
	height: calc(100% - 24px);
	object-fit: cover;
	object-position: top;
	display: block;
}

.mockup-phone {
	position: absolute;
	left: 1.25rem;
	bottom: -1px;
	width: 92px;
	border: 4px solid #0f172a;
	border-bottom: none;
	border-radius: 1.1rem 1.1rem 0 0;
	overflow: hidden;
	box-shadow: 0 14px 30px rgba(15, 23, 42, 0.3);
	background: #0f172a;
	transition: transform 0.4s ease;
}

.mockup-phone img {
	width: 100%;
	height: 175px;
	object-fit: cover;
	object-position: top;
	display: block;
	border-radius: 0.75rem 0.75rem 0 0;
}

.project-card:hover .mockup-desktop {
	transform: translateY(-6px);
}

.project-card:hover .mockup-phone {
	transform: translateY(-4px);
}

.project-info {
	padding: 1.5rem;
}

.project-tag {
	display: inline-block;
	background: #dbeafe;
	color: #1e40af;
	font-size: 0.75rem;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.5px;
	padding: 0.35rem 0.9rem;
	border-radius: 2rem;
	margin-bottom: 0.9rem;
}

.project-tag.tag-ecommerce {
	background: #dcfce7;
	color: #166534;
}

.project-tag.tag-landing {
	background: #fae8ff;
	color: #86198f;
}

.project-tag.tag-sistema {
	background: #fef3c7;
	color: #92400e;
}

.project-info h3 {
	color: #0f172a;
	font-size: 1.35rem;
	margin-bottom: 0.5rem;
}

.project-info p {
	color: #64748b;
	font-size: 0.95rem;
	line-height: 1.6;
}

@media (max-width: 1024px) {
	.impact-stats {
		grid-template-columns: repeat(2, 1fr);
	}

}

@media (max-width: 768px) {
	.portfolio-container {
		padding-top: 6.5rem;
	}

	.hero-title {
		font-size: 2.5rem;
	}

	.impact-stats,
	.projects-grid {
		grid-template-columns: 1fr;
	}
}
</style>

<script>
	const initFilters = () => {
		const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
		const cards = document.querySelectorAll<HTMLElement>('.project-card');

		if (!buttons.length) return;

		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				buttons.forEach((b) => b.classList.remove('active'));
				btn.classList.add('active');

				const filter = btn.dataset.filter;
				cards.forEach((card) => {
					const show = filter === 'todos' || card.dataset.category === filter;
					card.classList.toggle('hidden', !show);
				});
			});
		});
	};

	initFilters();
	document.addEventListener('astro:page-load', initFilters);
</script>

