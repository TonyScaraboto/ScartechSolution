---
import ContactCTA from '../components/ContactCTA.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Portfólio | Scartech Solution"
	description="Projetos de sites, e-commerce e campanhas de tráfego pago"
>
	<div class="portfolio-container">
		<!-- Hero -->
		<section class="hero-portfolio">
			<h1 class="hero-title">Nosso <span class="highlight">Portfólio</span></h1>
			<p class="hero-subtitle">Projetos reais de sites, e-commerce e campanhas de tráfego pago</p>
		</section>

		<!-- Estatísticas de Impacto -->
		<section class="impact-stats">
			<div class="stat-card">
				<img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=800&q=80" alt="Sites entregues" class="stat-img" />
				<div class="stat-number">50+</div>
				<div class="stat-label">Sites e lojas entregues</div>
			</div>
			<div class="stat-card">
				<img src="https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?auto=format&fit=crop&w=800&q=80" alt="Campanhas" class="stat-img" />
				<div class="stat-number">100+</div>
				<div class="stat-label">Campanhas de tráfego gerenciadas</div>
			</div>
			<div class="stat-card">
				<img src="https://images.unsplash.com/photo-1556761175-5973dc0f32e7?auto=format&fit=crop&w=800&q=80" alt="Satisfação" class="stat-img" />
				<div class="stat-number">100%</div>
				<div class="stat-label">Satisfação dos clientes</div>
			</div>
			<div class="stat-card">
				<img src="https://images.unsplash.com/photo-1551434678-e076c223a692?auto=format&fit=crop&w=800&q=80" alt="Suporte" class="stat-img" />
				<div class="stat-number">3x</div>
				<div class="stat-label">ROI médio em campanhas</div>
			</div>
		</section>

		<!-- Projetos -->
		<section class="projects-section">
			<h2 class="section-title">Projetos Entregues</h2>
			<p class="section-subtitle">Projetos reais desenvolvidos pela Scartech Solution, com sites publicados e código no GitHub</p>

			<div class="filter-bar">
				<button class="filter-btn active" data-filter="todos">Todos</button>
				<button class="filter-btn" data-filter="sites">Sites Institucionais</button>
				<button class="filter-btn" data-filter="landing">Landing Pages</button>
				<button class="filter-btn" data-filter="sistemas">Sistemas Web</button>
			</div>

			<div class="projects-grid">
				<div class="project-card" data-category="sites">
					<div class="project-img-wrap">
						<img src="https://raw.githubusercontent.com/TonyScaraboto/GM-Eletrica/main/public/images/services/empresarial-servico.jpg" alt="Site GM Elétrica" class="project-img" loading="lazy" />
					</div>
					<div class="project-info">
						<span class="project-tag">Site Institucional</span>
						<h3>GM Elétrica</h3>
						<p>Site institucional para empresa de serviços elétricos residenciais, empresariais e industriais, com catálogo de serviços e contato direto via WhatsApp</p>
						<a class="project-link" href="https://gmeletrica.vercel.app" target="_blank" rel="noopener">Ver site no ar →</a>
					</div>
				</div>
				<div class="project-card" data-category="sites">
					<div class="project-img-wrap">
						<img src="https://raw.githubusercontent.com/TonyScaraboto/lele_estudio_automotiva-/main/public/images/hero-fachada.jpeg" alt="Site Lelê Estúdio Automotivo" class="project-img" loading="lazy" />
					</div>
					<div class="project-info">
						<span class="project-tag">Site Institucional</span>
						<h3>Lelê Estúdio Automotivo</h3>
						<p>Site institucional para estúdio de estética automotiva, com galeria de serviços de lavagem, pintura e detalhamento de carros e motos</p>
						<a class="project-link" href="https://tonyscaraboto.github.io/lele_estudio_automotiva-/" target="_blank" rel="noopener">Ver site no ar →</a>
					</div>
				</div>
				<div class="project-card" data-category="landing">
					<div class="project-img-wrap">
						<img src="https://raw.githubusercontent.com/TonyScaraboto/maxpower/main/public/images/hero-video.jpg" alt="Site MaxPower" class="project-img" loading="lazy" />
					</div>
					<div class="project-info">
						<span class="project-tag tag-landing">Landing Page Internacional</span>
						<h3>MaxPower</h3>
						<p>Landing page em inglês para indústria de aquecedores e isolamento térmico, com catálogo de produtos e captação de leads no mercado americano</p>
						<a class="project-link" href="https://maxpowerindustrialheaters.com/" target="_blank" rel="noopener">Ver site no ar →</a>
					</div>
				</div>
				<div class="project-card" data-category="sistemas">
					<div class="project-img-wrap">
						<img src="/assets/scartech-manager.png" alt="Sistema ScarTech Manager" class="project-img" loading="lazy" />
					</div>
					<div class="project-info">
						<span class="project-tag tag-sistema">Sistema Web</span>
						<h3>ScarTech Manager</h3>
						<p>Sistema completo de gestão para assistências técnicas, com painel administrativo, controle de ordens de serviço e área de login para clientes</p>
						<a class="project-link" href="https://www.scartechmanager.com.br/" target="_blank" rel="noopener">Ver sistema no ar →</a>
					</div>
				</div>
			</div>
		</section>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
.portfolio-container {
	background: #f8fafc;
	min-height: 100vh;
	position: relative;
	z-index: 2;
	padding-top: 7rem;
	overflow: hidden;
}

.hero-portfolio {
	max-width: 1400px;
	margin: 0 auto 4rem;
	padding: 0 2rem;
	text-align: center;
}

.hero-title {
	font-size: 4rem;
	font-weight: 900;
	color: #0f172a;
	margin-bottom: 1.5rem;
}

.highlight {
	background: linear-gradient(135deg, #3b82f6, #2563eb);
	-webkit-background-clip: text;
	-webkit-text-fill-color: transparent;
	background-clip: text;
}

.hero-subtitle {
	font-size: 1.4rem;
	color: #64748b;
}

.section-title {
	font-size: 2.5rem;
	font-weight: 900;
	color: #0f172a;
	margin-bottom: 3rem;
	text-align: center;
}

/* Stats */
.impact-stats {
	max-width: 1400px;
	margin: 0 auto 4rem;
	padding: 0 2rem;
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	gap: 2rem;
}

.stat-card {
	background: #ffffff;
	padding: 2rem;
	border-radius: 1rem;
	border: 1px solid #e2e8f0;
	box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
	text-align: center;
	transition: transform 0.3s ease, box-shadow 0.3s ease;
	overflow: hidden;
	position: relative;
}

.stat-card:hover {
	transform: translateY(-6px);
	box-shadow: 0 16px 40px rgba(37, 99, 235, 0.12);
}

.stat-img {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	object-fit: cover;
	opacity: 0.1;
	z-index: -1;
}

.stat-number {
	font-size: 3.5rem;
	font-weight: 900;
	background: linear-gradient(135deg, #3b82f6, #2563eb);
	-webkit-background-clip: text;
	-webkit-text-fill-color: transparent;
	background-clip: text;
	margin-bottom: 0.5rem;
}

.stat-label {
	color: #64748b;
	font-size: 1rem;
}

/* Projects */
.projects-section {
	max-width: 1400px;
	margin: 4rem auto;
	padding: 0 2rem;
}

.section-subtitle {
	color: #64748b;
	font-size: 1.15rem;
	text-align: center;
	max-width: 600px;
	margin: -2rem auto 2.5rem;
}

/* Filtro */
.filter-bar {
	display: flex;
	justify-content: center;
	gap: 0.75rem;
	flex-wrap: wrap;
	margin-bottom: 3rem;
}

.filter-btn {
	background: #ffffff;
	border: 1px solid #cbd5e1;
	color: #475569;
	font-weight: 600;
	font-size: 0.9rem;
	padding: 0.6rem 1.4rem;
	border-radius: 2rem;
	cursor: pointer;
	transition: all 0.25s ease;
	font-family: inherit;
}

.filter-btn:hover {
	border-color: #93c5fd;
	color: #1e40af;
}

.filter-btn.active {
	background: #1e40af;
	border-color: #1e40af;
	color: #ffffff;
}

/* Grid de projetos */
.projects-grid {
	display: grid;
	grid-template-columns: repeat(2, 1fr);
	gap: 2rem;
	max-width: 1100px;
	margin: 0 auto;
}

.project-card {
	background: #ffffff;
	border-radius: 1rem;
	overflow: hidden;
	border: 1px solid #e2e8f0;
	box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
	transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.project-card:hover {
	transform: translateY(-6px);
	box-shadow: 0 16px 40px rgba(37, 99, 235, 0.12);
}

.project-card.hidden {
	display: none;
}

.project-img-wrap {
	overflow: hidden;
	height: 220px;
}

.project-img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	transition: transform 0.4s ease;
}

.project-card:hover .project-img {
	transform: scale(1.06);
}

.project-info {
	padding: 1.5rem;
}

.project-tag {
	display: inline-block;
	background: #dbeafe;
	color: #1e40af;
	font-size: 0.75rem;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.5px;
	padding: 0.35rem 0.9rem;
	border-radius: 2rem;
	margin-bottom: 0.9rem;
}

.project-tag.tag-landing {
	background: #dcfce7;
	color: #166534;
}

.project-tag.tag-sistema {
	background: #fef3c7;
	color: #92400e;
}

.project-info h3 {
	color: #0f172a;
	font-size: 1.35rem;
	margin-bottom: 0.5rem;
}

.project-info p {
	color: #64748b;
	font-size: 0.95rem;
	line-height: 1.6;
}

.project-link {
	display: inline-block;
	margin-top: 1rem;
	color: #1e40af;
	font-weight: 700;
	font-size: 0.9rem;
	text-decoration: none;
	transition: color 0.2s ease;
}

.project-link:hover {
	color: #2563eb;
	text-decoration: underline;
}

@media (max-width: 1024px) {
	.impact-stats {
		grid-template-columns: repeat(2, 1fr);
	}

}

@media (max-width: 768px) {
	.portfolio-container {
		padding-top: 12rem;
	}

	.hero-title {
		font-size: 2.5rem;
	}

	.impact-stats,
	.projects-grid {
		grid-template-columns: 1fr;
	}
}
</style>

<script>
	const initFilters = () => {
		const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
		const cards = document.querySelectorAll<HTMLElement>('.project-card');

		if (!buttons.length) return;

		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				buttons.forEach((b) => b.classList.remove('active'));
				btn.classList.add('active');

				const filter = btn.dataset.filter;
				cards.forEach((card) => {
					const show = filter === 'todos' || card.dataset.category === filter;
					card.classList.toggle('hidden', !show);
				});
			});
		});
	};

	initFilters();
	document.addEventListener('astro:page-load', initFilters);
</script>

