/* Animações de Scroll Reveal */
.scroll-reveal {
  opacity: 0;
  transform: translateY(50px);
  transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
              transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}

.scroll-reveal.revealed {
  opacity: 1;
  transform: translateY(0);
}

/* Animações escalonadas para cards */
.metodologia-step,
.problem-card,
.servico-card,
.garantia-card {
  opacity: 0;
  transform: translateY(40px) scale(0.95);
  transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
              transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

.metodologia-step.revealed,
.problem-card.revealed,
.servico-card.revealed,
.garantia-card.revealed {
  opacity: 1;
  transform: translateY(0) scale(1);
}

/* Delay escalonado */
.metodologia-step:nth-child(1).revealed { transition-delay: 0.1s; }
.metodologia-step:nth-child(2).revealed { transition-delay: 0.2s; }
.metodologia-step:nth-child(3).revealed { transition-delay: 0.3s; }
.metodologia-step:nth-child(4).revealed { transition-delay: 0.4s; }
.metodologia-step:nth-child(5).revealed { transition-delay: 0.5s; }

.problem-card:nth-child(1).revealed { transition-delay: 0.1s; }
.problem-card:nth-child(2).revealed { transition-delay: 0.2s; }
.problem-card:nth-child(3).revealed { transition-delay: 0.3s; }

.servico-card:nth-child(1).revealed { transition-delay: 0.1s; }
.servico-card:nth-child(2).revealed { transition-delay: 0.15s; }
.servico-card:nth-child(3).revealed { transition-delay: 0.2s; }
.servico-card:nth-child(4).revealed { transition-delay: 0.25s; }
.servico-card:nth-child(5).revealed { transition-delay: 0.3s; }
.servico-card:nth-child(6).revealed { transition-delay: 0.35s; }

/* Animação de títulos */
.section-title,
.section-subtitle {
  opacity: 0;
  transform: translateY(30px);
  transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s,
              transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s;
}

.section-title.revealed,
.section-subtitle.revealed {
  opacity: 1;
  transform: translateY(0);
}

</style>

<script>
  // Intersection Observer para animações de scroll
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('revealed');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  const initPage = () => {
    observer.disconnect();

    const elements = document.querySelectorAll(
      '.section-title, .section-subtitle, .metodologia-step, .problem-card, .servico-card, .garantia-card, .metodologia-badge, .cta-content'
    );

    elements.forEach((element) => {
      element.classList.remove('revealed');
      observer.observe(element);
    });

    const emailBtn = document.querySelector('.email-btn') as HTMLAnchorElement | null;
    if (emailBtn && !emailBtn.dataset.desktopListener) {
      const isMobileDevice = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);

      if (!isMobileDevice) {
        emailBtn.addEventListener('click', (event) => {
          event.preventDefault();
          const gmailUrl = 'https://mail.google.com/mail/?view=cm&to=contatoscartech@gmail.com&su=Contato%20pelo%20site%20Scartech%20Solution&body=Olá,%0D%0A%0D%0ATomei%20conhecimento%20dos%20serviços%20Web%20pelo%20site%20e%20gostaria%20de%20mais%20informações.%0D%0A%0D%0AAtenciosamente,';
          window.open(gmailUrl, '_blank');
        });
        emailBtn.dataset.desktopListener = 'true';
      }
    }
  };

  const scheduleInit = () => {
    requestAnimationFrame(() => {
      requestAnimationFrame(initPage);
    });
  };

  if (document.readyState !== 'loading') {
    requestAnimationFrame(initPage);
  } else {
    document.addEventListener('DOMContentLoaded', initPage);
  }

  document.addEventListener('astro:after-swap', initPage);
  document.addEventListener('astro:page-load', scheduleInit);
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) {
      initPage();
    }
  });
</script>

