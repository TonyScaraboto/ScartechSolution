---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Scartech Solution | Sites, E-commerce e Tráfego Pago"
  description="Desenvolvimento de sites institucionais, e-commerce e gestão de tráfego pago no Google Ads, Facebook e Instagram."
>
  <div class="main-hero-light">
    <!-- Hero Section - Primeira Impressão -->
    <section class="hero-yup">
      <div class="hero-grid">
        <div class="hero-content">
          <p class="empresa-desc">Desenvolvimento Web & Tráfego Pago</p>
          <h1 class="hero-title">Sites que convertem e anúncios que <span class="highlight">geram vendas</span></h1>
          <p class="hero-subtitle">Criamos sites institucionais, lojas virtuais e campanhas de tráfego pago no Google, Facebook e Instagram. <strong>Presença digital completa para o seu negócio crescer.</strong></p>
          <div class="hero-actions">
            <a href="https://wa.me/5513991836523?text=Olá,%20gostaria%20de%20saber%20mais%20sobre%20sites%20e%20tráfego%20pago!" class="whatsapp-btn">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Fale com um Especialista
            </a>
            <a href="/services" class="hero-btn-secondary">Conheça os serviços</a>
          </div>
          <div class="hero-trust">
            <span>✓ Sites profissionais</span>
            <span>✓ Campanhas otimizadas</span>
            <span>✓ Resultados mensuráveis</span>
          </div>
        </div>
        <div class="hero-visual">
          <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1000&q=80" alt="Dashboard de resultados de marketing digital" class="hero-visual-img" />
          <div class="hero-badge hero-badge-top">
            <span class="hero-badge-number">3x</span>
            <span class="hero-badge-label">ROI médio em campanhas</span>
          </div>
          <div class="hero-badge hero-badge-bottom">
            <span class="hero-badge-number">50+</span>
            <span class="hero-badge-label">Projetos entregues</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Nosso Processo -->
    <section class="metodologia-section">
      <div class="metodologia-badge">Como Trabalhamos</div>
      <h2 class="section-title">Do site ao anúncio, tudo integrado</h2>
      <p class="section-subtitle">Processo estruturado para entregar presença digital e campanhas que convertem</p>
      <div class="metodologia-grid">
        <div class="metodologia-step">
          <div class="step-number">01</div>
          <h3>Diagnóstico</h3>
          <p>Analisamos seu negócio, concorrência e objetivos de venda</p>
        </div>
        <div class="metodologia-step">
          <div class="step-number">02</div>
          <h3>Estratégia</h3>
          <p>Definimos o site ideal e o plano de tráfego pago</p>
        </div>
        <div class="metodologia-step">
          <div class="step-number">03</div>
          <h3>Desenvolvimento</h3>
          <p>Criamos seu site ou e-commerce com foco em conversão</p>
        </div>
        <div class="metodologia-step">
          <div class="step-number">04</div>
          <h3>Campanhas</h3>
          <p>Configuramos e lançamos anúncios no Google, Facebook e Instagram</p>
        </div>
        <div class="metodologia-step">
          <div class="step-number">05</div>
          <h3>Otimização</h3>
          <p>Monitoramos resultados e ajustamos para maximizar o retorno</p>
        </div>
      </div>
    </section>

    <!-- Problemas que Resolvemos -->
    <section class="problems-section">
      <h2 class="section-title">Você enfrenta esses desafios?</h2>
      <p class="section-subtitle">Problemas comuns que impedem empresas de vender online</p>
      <div class="problems-grid">
        <div class="problem-card">
          <div class="problem-icon"><Icon icon="pencil-line" size="2.5rem" color="#ef4444" /></div>
          <h3>Site Desatualizado ou Inexistente</h3>
          <p>Sem presença digital profissional, clientes não encontram sua empresa e acabam indo para a concorrência.</p>
          <div class="problem-impact"><strong>Impacto:</strong> Perda de credibilidade e oportunidades de venda</div>
        </div>
        <div class="problem-card">
          <div class="problem-icon"><Icon icon="strategy" size="2.5rem" color="#ef4444" /></div>
          <h3>Anúncios Sem Retorno</h3>
          <p>Investimento em tráfego pago sem estratégia, segmentação ou acompanhamento gera prejuízo em vez de clientes.</p>
          <div class="problem-impact"><strong>Impacto:</strong> Dinheiro jogado fora em campanhas mal configuradas</div>
        </div>
        <div class="problem-card">
          <div class="problem-icon"><Icon icon="code" size="2.5rem" color="#ef4444" /></div>
          <h3>Loja Virtual Que Não Vende</h3>
          <p>E-commerce mal estruturado, sem checkout otimizado ou integração com meios de pagamento, frustra compradores.</p>
          <div class="problem-impact"><strong>Impacto:</strong> Carrinhos abandonados e vendas perdidas</div>
        </div>
      </div>
    </section>

    <!-- Serviços -->
    <section class="servicos-section">
      <h2 class="section-title">Nossos serviços</h2>
      <p class="section-subtitle">Desenvolvimento web e tráfego pago para o seu negócio decolar</p>
      <div class="servicos-grid">
        <div class="servico-card" style="--card-bg: url('https://images.unsplash.com/photo-1467232004584-a241de8bcf5d?auto=format&fit=crop&w=800&q=80')">
          <div class="servico-card-overlay"></div>
          <div class="servico-card-content">
            <h3>Sites Institucionais</h3>
            <p>Presença digital profissional que transmite credibilidade e atrai clientes.</p>
            <ul class="features-list">
              <li>✓ Design responsivo</li>
              <li>✓ SEO otimizado</li>
              <li>✓ Alta performance</li>
            </ul>
          </div>
        </div>
        <div class="servico-card featured" style="--card-bg: url('https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=800&q=80')">
          <div class="popular-badge">Mais Popular</div>
          <div class="servico-card-overlay"></div>
          <div class="servico-card-content">
            <h3>E-commerce</h3>
            <p>Loja virtual completa para vender seus produtos 24 horas por dia.</p>
            <ul class="features-list">
              <li>✓ Catálogo de produtos</li>
              <li>✓ Pagamentos integrados</li>
              <li>✓ Painel de gestão</li>
            </ul>
          </div>
        </div>
        <div class="servico-card" style="--card-bg: url('https://images.unsplash.com/photo-1432888498266-38ffec3eaf0a?auto=format&fit=crop&w=800&q=80')">
          <div class="servico-card-overlay"></div>
          <div class="servico-card-content">
            <h3>Landing Pages</h3>
            <p>Páginas de alta conversão ideais para campanhas de tráfego pago.</p>
            <ul class="features-list">
              <li>✓ Foco em conversão</li>
              <li>✓ Integração com anúncios</li>
              <li>✓ Analytics configurado</li>
            </ul>
          </div>
        </div>
        <div class="servico-card" style="--card-bg: url('https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&w=800&q=80')">
          <div class="servico-card-overlay"></div>
          <div class="servico-card-content">
            <h3>Google Ads</h3>
            <p>Campanhas de pesquisa, display e shopping para aparecer no Google.</p>
            <ul class="features-list">
              <li>✓ Palavras-chave estratégicas</li>
              <li>✓ Remarketing</li>
              <li>✓ Relatórios de ROI</li>
            </ul>
          </div>
        </div>
        <div class="servico-card" style="--card-bg: url('https://images.unsplash.com/photo-1611262588024-d12430b98920?auto=format&fit=crop&w=800&q=80')">
          <div class="servico-card-overlay"></div>
          <div class="servico-card-content">
            <h3>Facebook & Instagram Ads</h3>
            <p>Anúncios segmentados nas redes sociais para alcançar seu público ideal.</p>
            <ul class="features-list">
              <li>✓ Segmentação avançada</li>
              <li>✓ Criativos otimizados</li>
              <li>✓ Pixel e conversões</li>
            </ul>
          </div>
        </div>
        <div class="servico-card" style="--card-bg: url('https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=800&q=80')">
          <div class="servico-card-overlay"></div>
          <div class="servico-card-content">
            <h3>Gestão de Tráfego Pago</h3>
            <p>Gerenciamento completo das suas campanhas com otimização contínua.</p>
            <ul class="features-list">
              <li>✓ Monitoramento diário</li>
              <li>✓ Ajustes estratégicos</li>
              <li>✓ Relatórios mensais</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Garantias - Reduzir Risco -->
    <section class="garantias-section">
      <h2 class="section-title">Nossa Garantia de Satisfação</h2>
      <div class="garantias-grid">
        <div class="garantia-card">
          <div class="garantia-icon"><Icon icon="strategy" size="2rem" color="#3b82f6" /></div>
          <h3>100% Seguro</h3>
          <p>Seus dados e informações protegidos com máxima segurança</p>
        </div>
        <div class="garantia-card">
          <div class="garantia-icon"><Icon icon="rocket-launch" size="2rem" color="#3b82f6" /></div>
          <h3>Entrega Rápida</h3>
          <p>Projetos entregues no prazo ou seu dinheiro de volta</p>
        </div>
        <div class="garantia-card">
          <div class="garantia-icon"><Icon icon="arrow-right" size="2rem" color="#3b82f6" /></div>
          <h3>Revisões Ilimitadas</h3>
          <p>Ajustes até você ficar 100% satisfeito</p>
        </div>
        <div class="garantia-card">
          <div class="garantia-icon"><Icon icon="trophy" size="2rem" color="#3b82f6" /></div>
          <h3>Suporte Vitalício</h3>
          <p>Assistência contínua mesmo após a entrega</p>
        </div>
      </div>
    </section>

    <!-- CTA Final - Conversão -->
    <section class="cta-section">
      <div class="cta-content">
        <div class="cta-info">
          <div class="cta-badge">Consultoria Gratuita</div>
          <h2>Pronto para vender mais online?</h2>
          <p class="cta-main">Agende uma <strong>consultoria gratuita</strong> e receba um <strong>diagnóstico completo</strong> do seu site e campanhas de tráfego pago.</p>
          <div class="cta-benefits">
            <div class="cta-benefit">✓ Análise completa gratuita</div>
            <div class="cta-benefit">✓ Proposta personalizada</div>
            <div class="cta-benefit">✓ Sem compromisso</div>
          </div>
        </div>
        <div class="cta-actions">
          <a href="https://wa.me/5513991836523?text=Olá,%20gostaria%20de%20saber%20mais%20sobre%20sites%20e%20tráfego%20pago!" class="cta-btn primary">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Falar no WhatsApp
          </a>
          <a href="mailto:contatoscartech@gmail.com?subject=Contato%20pelo%20site%20Scartech%20Solution&body=Olá,%0D%0A%0D%0ATomei%20conhecimento%20dos%20serviços%20Web%20pelo%20site%20e%20gostaria%20de%20mais%20informações.%0D%0A%0D%0AAtenciosamente," class="cta-btn secondary email-btn">
            Enviar E-mail
          </a>
          <p class="cta-guarantee">✓ Resposta em até 2 horas<br />Orçamento sem compromisso</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
/* Reset e Base */
* {
  box-sizing: border-box;
}

/* Layout Principal */
.main-hero-light {
  background: #f8fafc;
  min-height: 100vh;
  padding: 6rem 1rem 4rem;
  position: relative;
  overflow: hidden;
}

/* Animações de entrada do hero */
@keyframes heroFadeUp {
  from {
    opacity: 0;
    transform: translateY(24px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes heroFadeRight {
  from {
    opacity: 0;
    transform: translateX(40px) scale(0.97);
  }
  to {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

@keyframes heroBadgePop {
  from {
    opacity: 0;
    transform: translateY(14px) scale(0.8);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.hero-content > * {
  animation: heroFadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.hero-content .empresa-desc { animation-delay: 0.1s; }
.hero-content .hero-title { animation-delay: 0.2s; }
.hero-content .hero-subtitle { animation-delay: 0.35s; }
.hero-content .hero-actions { animation-delay: 0.5s; }
.hero-content .hero-trust { animation-delay: 0.65s; }

.hero-visual {
  animation: heroFadeRight 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both;
}

.hero-badge-top {
  animation: heroBadgePop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.9s both;
}

.hero-badge-bottom {
  animation: heroBadgePop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 1.1s both;
}

@media (prefers-reduced-motion: reduce) {
  .hero-content > *,
  .hero-visual,
  .hero-badge-top,
  .hero-badge-bottom {
    animation: none;
  }
}

/* Hero Section - Primeira Impressão */
.hero-yup {
  background: linear-gradient(160deg, #0f172a 0%, #1e3a8a 100%);
  border-radius: 1.5rem;
  box-shadow: 0 20px 50px rgba(15, 23, 42, 0.25);
  padding: 4rem 3.5rem;
  max-width: 1200px;
  margin: 0 auto 5rem;
  animation: fadeInUp 0.5s ease-out forwards;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: 3.5rem;
  align-items: center;
}

.hero-content {
  text-align: left;
}

.hero-actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  align-items: center;
  margin-bottom: 2rem;
}

.hero-btn-secondary {
  display: inline-flex;
  align-items: center;
  color: #ffffff;
  font-weight: 700;
  font-size: 1rem;
  padding: 1rem 2rem;
  border-radius: 3rem;
  text-decoration: none;
  border: 1.5px solid rgba(255, 255, 255, 0.35);
  background: rgba(255, 255, 255, 0.06);
  transition: all 0.3s ease;
}

@media (hover: hover) {
  .hero-btn-secondary:hover {
    background: #ffffff;
    color: #1e3a8a;
    transform: translateY(-2px);
  }
}

.hero-visual {
  position: relative;
}

.hero-visual-img {
  width: 100%;
  height: 420px;
  object-fit: cover;
  border-radius: 1rem;
  box-shadow: 0 20px 50px rgba(2, 6, 23, 0.45);
  border: 1px solid rgba(255, 255, 255, 0.12);
}

.hero-badge {
  position: absolute;
  background: #ffffff;
  border-radius: 0.9rem;
  padding: 0.9rem 1.25rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  box-shadow: 0 12px 32px rgba(2, 6, 23, 0.35);
}

.hero-badge-top {
  top: 1.25rem;
  right: -1rem;
}

.hero-badge-bottom {
  bottom: 1.25rem;
  left: -1rem;
}

.hero-badge-number {
  font-size: 1.5rem;
  font-weight: 900;
  color: #1e40af;
  line-height: 1;
}

.hero-badge-label {
  font-size: 0.8rem;
  font-weight: 600;
  color: #475569;
  max-width: 9rem;
  line-height: 1.3;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translate3d(0, 16px, 0);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

.hero-title {
  color: #ffffff;
  font-size: clamp(1.8rem, 5vw, 2.8rem);
  font-weight: 900;
  line-height: 1.2;
  margin-bottom: 1rem;
  letter-spacing: -0.02em;
}

.highlight {
  background: linear-gradient(120deg, #60a5fa 0%, #93c5fd 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.empresa-desc {
  color: #93c5fd;
  font-weight: 700;
  margin-bottom: 0.8rem;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  font-size: 0.85rem;
}

.hero-subtitle {
  color: #cbd5e1;
  font-size: clamp(1rem, 2.5vw, 1.2rem);
  line-height: 1.6;
  margin-bottom: 2rem;
  max-width: 560px;
}

.hero-subtitle strong {
  color: #ffffff;
  font-weight: 700;
}

.hero-trust {
  display: flex;
  gap: 1.25rem 1.75rem;
  flex-wrap: wrap;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
}

.hero-trust span {
  color: #e2e8f0;
  font-weight: 600;
  font-size: 0.9rem;
  white-space: nowrap;
}

.whatsapp-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  background: linear-gradient(135deg, #25d366 0%, #20ba5a 100%);
  color: #fff;
  font-weight: 700;
  font-size: 1rem;
  padding: 1rem 2rem;
  border-radius: 3rem;
  text-decoration: none;
  box-shadow: 0 8px 24px rgba(37, 211, 102, 0.3), 0 4px 8px rgba(0, 0, 0, 0.1);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@media (hover: hover) {
  .whatsapp-btn:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 12px 32px rgba(37, 211, 102, 0.4), 0 6px 12px rgba(0, 0, 0, 0.15);
    background: linear-gradient(135deg, #20ba5a 0%, #25d366 100%);
  }
}

.whatsapp-btn:active {
  transform: translateY(-1px) scale(0.98);
}

/* Processo de Trabalho */
.metodologia-section {
  max-width: 1400px;
  margin: 5rem auto;
  padding: 0 1rem;
  text-align: center;
  position: relative;
}

.metodologia-badge {
  display: inline-block;
  background: #dbeafe;
  color: #1e40af;
  padding: 0.6rem 1.5rem;
  border-radius: 2rem;
  font-size: 0.85rem;
  font-weight: 700;
  margin-bottom: 1.5rem;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  border: 1px solid #bfdbfe;
}

.metodologia-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 2rem;
  margin-top: 3rem;
}

.metodologia-step {
  background: #ffffff;
