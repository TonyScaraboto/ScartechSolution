---
import ContactCTA from '../components/ContactCTA.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Serviços | Scartech Solution" description="Sites institucionais, e-commerce e tráfego pago no Google Ads, Facebook e Instagram">
  <div class="services-container">
    <!-- Hero Section -->
    <section class="hero-services">
      <h1 class="hero-title">Nossos <span class="highlight">Serviços</span></h1>
      <p class="hero-subtitle">Desenvolvimento web e tráfego pago para impulsionar suas vendas online</p>
    </section>

    <!-- Serviços Grid -->
    <section class="services-grid-section">
      <div class="services-grid">
        <!-- Sites Institucionais -->
        <div class="service-card">
          <img 
            src="https://images.unsplash.com/photo-1467232004584-a241de8bcf5d?auto=format&fit=crop&w=1200&q=80" 
            alt="Sites Institucionais"
            class="service-image"
          />
          <div class="service-content">
            <div class="service-icon"><Icon icon="code" size="2.5rem" color="#3b82f6" /></div>
            <h3>Sites Institucionais</h3>
            <p>Sites profissionais, modernos e responsivos que transmitem credibilidade e fortalecem a marca da sua empresa.</p>
            <ul class="service-features">
              <li>✓ Design personalizado e responsivo</li>
              <li>✓ SEO otimizado para Google</li>
              <li>✓ Alta performance e velocidade</li>
              <li>✓ Formulários e integração com WhatsApp</li>
            </ul>
            <div class="service-stats">
              <span>Entrega média: <strong>15 a 30 dias</strong></span>
            </div>
          </div>
        </div>

        <!-- E-commerce -->
        <div class="service-card">
          <img 
            src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=1200&q=80" 
            alt="E-commerce"
            class="service-image"
          />
          <div class="service-content">
            <div class="service-icon"><Icon icon="terminal-window" size="2.5rem" color="#3b82f6" /></div>
            <h3>E-commerce</h3>
            <p>Lojas virtuais completas para vender seus produtos online 24 horas por dia, 7 dias por semana.</p>
            <ul class="service-features">
              <li>✓ Catálogo de produtos completo</li>
              <li>✓ Checkout otimizado para conversão</li>
              <li>✓ Integração com meios de pagamento</li>
              <li>✓ Painel de gestão de pedidos</li>
            </ul>
            <div class="service-stats">
              <span>Resultado: <strong>+200% em vendas online</strong></span>
            </div>
          </div>
        </div>

        <!-- Landing Pages -->
        <div class="service-card">
          <img 
            src="https://images.unsplash.com/photo-1432888498266-38ffec3eaf0a?auto=format&fit=crop&w=1200&q=80" 
            alt="Landing Pages"
            class="service-image"
          />
          <div class="service-content">
            <div class="service-icon"><Icon icon="rocket-launch" size="2.5rem" color="#3b82f6" /></div>
            <h3>Landing Pages</h3>
            <p>Páginas de alta conversão desenvolvidas para maximizar resultados de campanhas de tráfego pago.</p>
            <ul class="service-features">
              <li>✓ Design focado em conversão</li>
              <li>✓ Integração com pixels de rastreamento</li>
              <li>✓ Testes A/B e otimização</li>
              <li>✓ Analytics e relatórios configurados</li>
            </ul>
            <div class="service-stats">
              <span>Conversão: <strong>até 3x mais leads</strong></span>
            </div>
          </div>
        </div>

        <!-- Google Ads -->
        <div class="service-card">
          <img 
            src="https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&w=1200&q=80" 
            alt="Google Ads"
            class="service-image"
          />
          <div class="service-content">
            <div class="service-icon"><Icon icon="strategy" size="2.5rem" color="#3b82f6" /></div>
            <h3>Google Ads</h3>
            <p>Campanhas de pesquisa, display e shopping para colocar sua empresa na primeira página do Google.</p>
            <ul class="service-features">
              <li>✓ Pesquisa, Display e Shopping</li>
              <li>✓ Palavras-chave estratégicas</li>
              <li>✓ Remarketing e públicos personalizados</li>
              <li>✓ Relatórios de ROI e conversões</li>
            </ul>
            <div class="service-stats">
              <span>Alcance: <strong>milhões de buscas/dia</strong></span>
            </div>
          </div>
        </div>

        <!-- Facebook & Instagram Ads -->
        <div class="service-card">
          <img 
            src="https://images.unsplash.com/photo-1611262588024-d12430b98920?auto=format&fit=crop&w=1200&q=80" 
            alt="Facebook e Instagram Ads"
            class="service-image"
          />
          <div class="service-content">
            <div class="service-icon"><Icon icon="paper-plane-tilt" size="2.5rem" color="#3b82f6" /></div>
            <h3>Facebook & Instagram Ads</h3>
            <p>Anúncios segmentados no Meta Ads para alcançar seu público ideal no Facebook e Instagram.</p>
            <ul class="service-features">
              <li>✓ Segmentação avançada de público</li>
              <li>✓ Criativos e copies otimizados</li>
              <li>✓ Pixel Meta e API de conversões</li>
              <li>✓ Campanhas de engajamento e vendas</li>
            </ul>
            <div class="service-stats">
              <span>Plataformas: <strong>Facebook + Instagram</strong></span>
            </div>
          </div>
        </div>

        <!-- Gestão de Tráfego Pago -->
        <div class="service-card">
          <img 
            src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1200&q=80" 
            alt="Gestão de Tráfego Pago"
            class="service-image"
          />
          <div class="service-content">
            <div class="service-icon"><Icon icon="trophy" size="2.5rem" color="#3b82f6" /></div>
            <h3>Gestão de Tráfego Pago</h3>
            <p>Gerenciamento completo das suas campanhas com otimização contínua para maximizar o retorno sobre investimento.</p>
            <ul class="service-features">
              <li>✓ Monitoramento e ajustes diários</li>
              <li>✓ Google Ads + Meta Ads integrados</li>
              <li>✓ Relatórios mensais de performance</li>
              <li>✓ Estratégia personalizada por nicho</li>
            </ul>
            <div class="service-stats">
              <span>ROI médio: <strong>3x a 5x o investimento</strong></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Processo de Trabalho -->
    <section class="process-section">
      <h2 class="section-title">Como Trabalhamos</h2>
      <div class="process-grid">
        <div class="process-step">
          <div class="step-number">01</div>
          <img src="https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?auto=format&fit=crop&w=800&q=80" alt="Descoberta" class="process-img" />
          <h3>Diagnóstico</h3>
          <p>Analisamos seu negócio, site atual e campanhas existentes</p>
        </div>
        <div class="process-step">
          <div class="step-number">02</div>
          <img src="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=800&q=80" alt="Planejamento" class="process-img" />
          <h3>Proposta</h3>
          <p>Apresentamos a solução ideal com cronograma e investimento claro</p>
        </div>
        <div class="process-step">
          <div class="step-number">03</div>
          <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=800&q=80" alt="Desenvolvimento" class="process-img" />
          <h3>Desenvolvimento</h3>
          <p>Criamos seu site, e-commerce ou landing page com foco em conversão</p>
        </div>
        <div class="process-step">
          <div class="step-number">04</div>
          <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=800&q=80" alt="Testes" class="process-img" />
          <h3>Campanhas</h3>
          <p>Configuramos e lançamos anúncios no Google, Facebook e Instagram</p>
        </div>
        <div class="process-step">
          <div class="step-number">05</div>
          <img src="https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=800&q=80" alt="Entrega" class="process-img" />
          <h3>Otimização</h3>
          <p>Monitoramos resultados e ajustamos campanhas para maximizar vendas</p>
        </div>
      </div>
    </section>

    <!-- Garantias -->
    <section class="garantias-section">
      <h2 class="section-title">Nossas Garantias</h2>
      <div class="garantias-grid">
        <div class="garantia-card">
          <div class="garantia-icon"><Icon icon="trophy" size="2rem" color="#3b82f6" /></div>
          <h3>Resultados Reais</h3>
          <p>Projetos entregues com foco em conversão e retorno sobre investimento comprovado.</p>
        </div>
        <div class="garantia-card">
          <div class="garantia-icon"><Icon icon="terminal-window" size="2rem" color="#3b82f6" /></div>
          <h3>Suporte Contínuo</h3>
          <p>Acompanhamento pós-entrega e suporte para dúvidas e ajustes no site e campanhas.</p>
        </div>
        <div class="garantia-card">
          <div class="garantia-icon"><Icon icon="rocket-launch" size="2rem" color="#3b82f6" /></div>
          <h3>Transparência Total</h3>
          <p>Relatórios claros de performance com métricas de conversão, cliques e ROI das campanhas.</p>
        </div>
        <div class="garantia-card">
          <div class="garantia-icon"><Icon icon="strategy" size="2rem" color="#3b82f6" /></div>
          <h3>Segurança Total</h3>
          <p>Seus dados protegidos com criptografia e conformidade com LGPD.</p>
        </div>
      </div>
    </section>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
.services-container {
  background: #f8fafc;
  min-height: 100vh;
  position: relative;
  z-index: 2;
  padding-top: 7rem;
  overflow: hidden;
}

/* Hero */
.hero-services {
  max-width: 1400px;
  margin: 0 auto 4rem;
  padding: 0 2rem;
  text-align: center;
}

.hero-title {
  font-size: 4rem;
  font-weight: 900;
  color: #0f172a;
  margin-bottom: 1.5rem;
}

.highlight {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.hero-subtitle {
  font-size: 1.4rem;
  color: #64748b;
}

/* Services Grid */
.services-grid-section {
  max-width: 1400px;
  margin: 0 auto 4rem;
  padding: 0 2rem;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2rem;
}

.service-card {
  background: #ffffff;
  border-radius: 1rem;
  overflow: hidden;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

@media (hover: hover) {
  .service-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 50px rgba(37, 99, 235, 0.12);
  }
}

.service-image {
  width: 100%;
  height: 200px;
  object-fit: cover;
}

.service-content {
  padding: 2rem;
}

.service-icon {
  font-size: 3rem;
  margin-bottom: 1rem;
}

.service-content h3 {
  font-size: 1.8rem;
  color: #0f172a;
  margin-bottom: 1rem;
}

.service-content p {
  color: #64748b;
  line-height: 1.7;
  margin-bottom: 1.5rem;
}

.service-features {
  list-style: none;
  padding: 0;
  margin-bottom: 1.5rem;
}

.service-features li {
  color: #475569;
  padding: 0.5rem 0;
  font-size: 0.95rem;
}

.service-stats {
  padding-top: 1rem;
  border-top: 1px solid #e2e8f0;
  color: #64748b;
}

.service-stats strong {
  color: #1e40af;
  font-weight: 700;
}

/* Process Section */
.process-section {
  max-width: 1400px;
  margin: 4rem auto;
  padding: 0 2rem;
}

.section-title {
  font-size: 2.5rem;
  font-weight: 900;
  color: #0f172a;
  margin-bottom: 3rem;
  text-align: center;
}

.process-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 1.5rem;
}

.process-step {
  background: #ffffff;
  border-radius: 1rem;
  padding: 1.5rem;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
  text-align: center;
  position: relative;
}

.step-number {
  position: absolute;
  top: 1rem;
  right: 1rem;
  font-size: 2rem;
  font-weight: 900;
  color: rgba(59, 130, 246, 0.3);
}

.process-img {
  width: 100%;
  height: 120px;
  object-fit: cover;
  border-radius: 0.5rem;
  margin-bottom: 1rem;
}

.process-step h3 {
  font-size: 1.2rem;
  color: #0f172a;
  margin-bottom: 0.8rem;
}

.process-step p {
  font-size: 0.9rem;
  color: #64748b;
  line-height: 1.6;
}

/* Garantias */
.garantias-section {
  max-width: 1400px;
  margin: 4rem auto;
  padding: 0 2rem;
}

.garantias-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
  margin-top: 3rem;
}

.garantia-card {
  background: #ffffff;
  padding: 2rem;
  border-radius: 1rem;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
  text-align: center;
  transition: transform 0.3s ease;
}

@media (hover: hover) {
  .garantia-card:hover {
    transform: translateY(-5px);
  }
}

.garantia-icon {
  font-size: 3rem;
  margin-bottom: 1rem;
}

.garantia-card h3 {
  font-size: 1.3rem;
  color: #0f172a;
  margin-bottom: 0.8rem;
}

.garantia-card p {
  color: #64748b;
  line-height: 1.6;
  font-size: 0.95rem;
}

/* Responsive */
@media (max-width: 1024px) {
  .services-grid {
    grid-template-columns: 1fr;
  }

  .process-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .garantias-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {
  .services-container {
    padding-top: 12rem;
  }

  .hero-title {
    font-size: 2.5rem;
  }

  .process-grid,
  .garantias-grid {
    grid-template-columns: 1fr;
  }
}
</style>
