---
import ContactCTA from '../components/ContactCTA.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Sobre | Scartech Solution" description="Conheça a Scartech Solution - Especialistas em desenvolvimento web e tráfego pago">
  <div class="about-container">
    <!-- Hero Section -->
    <section class="hero-about">
      <div class="hero-content">
        <h1 class="hero-title">Sobre a <span class="highlight">Scartech Solution</span></h1>
        <p class="hero-subtitle">Especialistas em sites, e-commerce e tráfego pago para empresas que querem vender mais online</p>
      </div>
      <img 
        src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=2400&q=80" 
        alt="Equipe trabalhando em projetos de tecnologia"
        class="hero-image"
      />
    </section>

    <!-- Quem Somos -->
    <section class="content-section">
      <h2 class="section-title">Quem Somos</h2>
      <div class="content-grid">
        <div class="text-content">
          <p>
            A <strong>Scartech Solution</strong> é especializada em <strong>desenvolvimento web</strong> e <strong>tráfego pago</strong>. Criamos sites institucionais, lojas virtuais e campanhas de anúncios no Google Ads, Facebook e Instagram para empresas que querem crescer no digital.
          </p>
          <p>
            Nossa missão é simples: <strong>fazer seu negócio vender mais online</strong>. Combinamos sites profissionais com campanhas de tráfego pago estratégicas para gerar resultados mensuráveis e retorno sobre investimento.
          </p>
        </div>
        <img 
          src="https://images.unsplash.com/photo-1553877522-43269d4ea984?auto=format&fit=crop&w=1200&q=80" 
          alt="Tecnologia e Inovação"
          class="content-image"
        />
      </div>
    </section>

    <!-- Missão, Visão e Valores -->
    <section class="mvv-section">
      <h2 class="section-title">Missão, Visão e Valores</h2>
      <div class="mvv-grid">
        <div class="mvv-card">
          <div class="mvv-icon"><Icon icon="trophy" size="3rem" color="#3b82f6" /></div>
          <h3>Missão</h3>
          <p>Desenvolver sites e campanhas de tráfego pago que geram vendas reais e presença digital forte para empresas de todos os portes.</p>
        </div>
        <div class="mvv-card">
          <div class="mvv-icon"><Icon icon="rocket-launch" size="3rem" color="#3b82f6" /></div>
          <h3>Visão</h3>
          <p>Ser referência em desenvolvimento web e tráfego pago, reconhecida pelos resultados que entregamos aos nossos clientes.</p>
        </div>
        <div class="mvv-card">
          <div class="mvv-icon"><Icon icon="heart" size="3rem" color="#3b82f6" /></div>
          <h3>Valores</h3>
          <ul>
            <li>Resultado acima de tudo</li>
            <li>Transparência total</li>
            <li>Inovação constante</li>
            <li>Compromisso com qualidade</li>
            <li>Foco no cliente</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Metodologia -->
    <section class="metodologia-section">
      <h2 class="section-title">Nossa Metodologia</h2>
      <p class="section-subtitle">Processo integrado: do site ao anúncio</p>
      <div class="metodologia-grid">
        <div class="metodo-card">
          <div class="metodo-number">01</div>
          <img src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?auto=format&fit=crop&w=800&q=80" alt="Diagnóstico" class="metodo-img" />
          <h3>Diagnóstico</h3>
          <p>Analisamos seu negócio, concorrência e objetivos de venda online.</p>
        </div>
        <div class="metodo-card">
          <div class="metodo-number">02</div>
          <img src="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=800&q=80" alt="Estratégia" class="metodo-img" />
          <h3>Estratégia</h3>
          <p>Definimos o site ideal e o plano de tráfego pago para seu nicho.</p>
        </div>
        <div class="metodo-card">
          <div class="metodo-number">03</div>
          <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=800&q=80" alt="Desenvolvimento" class="metodo-img" />
          <h3>Desenvolvimento</h3>
          <p>Criamos seu site ou e-commerce com design profissional e foco em conversão.</p>
        </div>
        <div class="metodo-card">
          <div class="metodo-number">04</div>
          <img src="https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&w=800&q=80" alt="Campanhas" class="metodo-img" />
          <h3>Campanhas</h3>
          <p>Configuramos anúncios no Google, Facebook e Instagram.</p>
        </div>
        <div class="metodo-card">
          <div class="metodo-number">05</div>
          <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=800&q=80" alt="Otimização" class="metodo-img" />
          <h3>Otimização</h3>
          <p>Monitoramos resultados e ajustamos para maximizar vendas e ROI.</p>
        </div>
      </div>
    </section>

    <!-- Diferenciais -->
    <section class="diferenciais-section">
      <h2 class="section-title">Nossos Diferenciais</h2>
      <div class="diferenciais-grid">
        <div class="diferencial-card">
          <div class="diferencial-icon"><Icon icon="rocket-launch" size="2.5rem" color="#3b82f6" /></div>
          <h3>Rapidez na Entrega</h3>
          <p>Metodologia ágil que permite entregas em sprints de 2 semanas</p>
        </div>
        <div class="diferencial-card">
          <div class="diferencial-icon"><Icon icon="trophy" size="2.5rem" color="#3b82f6" /></div>
          <h3>Foco em Conversão</h3>
          <p>Cada site e campanha é pensado para gerar leads e vendas, não apenas visitas</p>
        </div>
        <div class="diferencial-card">
          <div class="diferencial-icon"><Icon icon="trophy" size="2.5rem" color="#3b82f6" /></div>
          <h3>Tráfego Pago Especializado</h3>
          <p>Expertise em Google Ads, Facebook e Instagram com otimização contínua</p>
        </div>
        <div class="diferencial-card">
          <div class="diferencial-icon"><Icon icon="rocket-launch" size="2.5rem" color="#3b82f6" /></div>
          <h3>Tecnologia de Ponta</h3>
          <p>Sempre utilizando as ferramentas mais modernas e eficientes</p>
        </div>
        <div class="diferencial-card">
          <div class="diferencial-icon"><Icon icon="strategy" size="2.5rem" color="#3b82f6" /></div>
          <h3>Relatórios Transparentes</h3>
          <p>Métricas claras de performance, conversões e retorno sobre investimento</p>
        </div>
        <div class="diferencial-card">
          <div class="diferencial-icon"><Icon icon="heart" size="2.5rem" color="#3b82f6" /></div>
          <h3>Parceria Real</h3>
          <p>Não somos apenas fornecedores, somos parceiros do seu sucesso</p>
        </div>
      </div>
    </section>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
.about-container {
  background: #f8fafc;
  min-height: 100vh;
  position: relative;
  z-index: 2;
  padding-top: 7rem;
  overflow: hidden;
}

/* Hero Section */
.hero-about {
  max-width: 1400px;
  margin: 0 auto 4rem;
  padding: 0 2rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
}

.hero-content {
  animation: fadeInUp 0.8s ease-out;
}

.hero-title {
  font-size: 3.5rem;
  font-weight: 900;
  color: #0f172a;
  margin-bottom: 1.5rem;
  line-height: 1.1;
}

.highlight {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.hero-subtitle {
  font-size: 1.3rem;
  color: #64748b;
  line-height: 1.6;
}

.hero-image {
  width: 100%;
  height: 500px;
  object-fit: cover;
  border-radius: 1rem;
  box-shadow: 0 20px 50px rgba(15, 23, 42, 0.15);
  animation: fadeIn 1s ease-out 0.3s backwards;
}

/* Content Section */
.content-section {
  max-width: 1400px;
  margin: 0 auto 4rem;
  padding: 0 2rem;
}

.section-title {
  font-size: 2.5rem;
  font-weight: 900;
  color: #0f172a;
  margin-bottom: 2rem;
  text-align: center;
}

.section-subtitle {
  font-size: 1.2rem;
  color: #64748b;
  text-align: center;
  margin-bottom: 3rem;
}

.content-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
}

.text-content p {
  font-size: 1.1rem;
  line-height: 1.8;
  color: #475569;
  margin-bottom: 1.5rem;
}

.text-content strong {
  color: #1e40af;
}

.content-image {
  width: 100%;
  height: 400px;
  object-fit: cover;
  border-radius: 1rem;
  box-shadow: 0 20px 50px rgba(15, 23, 42, 0.15);
}

/* MVV Section */
.mvv-section {
  max-width: 1400px;
  margin: 4rem auto;
  padding: 0 2rem;
}

.mvv-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  margin-top: 3rem;
}

.mvv-card {
  background: #ffffff;
  padding: 2.5rem;
  border-radius: 1rem;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.mvv-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 20px 50px rgba(37, 99, 235, 0.12);
}

.mvv-icon {
  font-size: 3rem;
  margin-bottom: 1rem;
}

.mvv-card h3 {
  font-size: 1.8rem;
  color: #0f172a;
  margin-bottom: 1rem;
}

.mvv-card p {
  color: #64748b;
  line-height: 1.7;
}

.mvv-card ul {
  list-style: none;
  padding: 0;
  color: #64748b;
}

.mvv-card ul li {
  padding: 0.5rem 0;
  padding-left: 1.5rem;
  position: relative;
}

.mvv-card ul li::before {
  content: '✓';
  position: absolute;
  left: 0;
  color: #2563eb;
  font-weight: bold;
}

/* Metodologia Section */
.metodologia-section {
  max-width: 1400px;
  margin: 4rem auto;
  padding: 0 2rem;
}

.metodologia-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 2rem;
  margin-top: 3rem;
}

.metodo-card {
  background: #ffffff;
  padding: 1.5rem;
  border-radius: 1rem;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
  text-align: center;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  position: relative;
  overflow: hidden;
}

.metodo-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 16px 40px rgba(37, 99, 235, 0.12);
}

.metodo-number {
  position: absolute;
  top: 1rem;
  right: 1rem;
  font-size: 2rem;
  font-weight: 900;
  color: rgba(59, 130, 246, 0.2);
}

.metodo-img {
  width: 100%;
  height: 150px;
  object-fit: cover;
  border-radius: 0.5rem;
  margin-bottom: 1rem;
}

.metodo-card h3 {
  font-size: 1.3rem;
  color: #0f172a;
  margin-bottom: 0.8rem;
}

.metodo-card p {
  font-size: 0.95rem;
  color: #64748b;
  line-height: 1.6;
}

/* Diferenciais Section */
.diferenciais-section {
  max-width: 1400px;
  margin: 4rem auto;
  padding: 0 2rem;
}

.diferenciais-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  margin-top: 3rem;
}

.diferencial-card {
  background: #ffffff;
  padding: 2rem;
  border-radius: 1rem;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
  transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
}

.diferencial-card:hover {
  transform: translateY(-5px);
  border-color: #93c5fd;
  box-shadow: 0 16px 40px rgba(37, 99, 235, 0.12);
}

.diferencial-icon {
  font-size: 3rem;
  margin-bottom: 1rem;
}

.diferencial-card h3 {
  font-size: 1.5rem;
  color: #0f172a;
  margin-bottom: 0.8rem;
}

.diferencial-card p {
  color: #64748b;
  line-height: 1.6;
}

/* Animations */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* Responsive */
@media (max-width: 1024px) {
  .hero-about,
  .content-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .metodologia-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .mvv-grid,
  .diferenciais-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  .about-container {
    padding-top: 6.5rem;
  }

  .hero-title {
    font-size: 2.5rem;
  }

  .section-title {
    font-size: 2rem;
  }

  .metodologia-grid {
    grid-template-columns: 1fr;
  }
}
</style>
